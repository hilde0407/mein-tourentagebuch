<?xml version="1.0" encoding="utf-8"?>
<!-- Heimnetz-Server (NAS, Nextcloud, WebDAV) laufen oft ohne HTTPS; deshalb ist unverschlüsselter Verkehr erlaubt. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
